# ==============================================================================
# Explainable Multimodal Deepfake & Media Forensics Platform
# Environment Configuration Template (.env.example)
#
# Copy this file to .env and fill in the appropriate values for your environment.
# DO NOT commit real secrets or .env files to source control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_NAME="Explainable Multimodal Deepfake & Media Forensics Platform"
APP_VERSION=0.1.0
# Set to "false" in production
DEBUG=true

# ------------------------------------------------------------------------------
# 2. POSTGRESQL DATABASE
# ------------------------------------------------------------------------------
# Database container credentials
POSTGRES_DB=deepfake
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Full connection string for SQLAlchemy
# - For Docker Compose: postgresql://<user>:<password>@postgres:5432/<db_name>
# - For Local Development: postgresql://<user>:<password>@localhost:5432/<db_name>
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/deepfake

# ------------------------------------------------------------------------------
# 3. REDIS & CELERY TASK QUEUE
# ------------------------------------------------------------------------------
# Redis connection URL used as broker & backend for async deepfake processing
# - For Docker Compose: redis://redis:6379/0
# - For Local Development: redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 4. JWT AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Secret key used for signing JWT tokens. In production, generate a secure random string:
# Run: openssl rand -hex 32
JWT_SECRET=change-me-to-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# ------------------------------------------------------------------------------
# 5. DETECTION PROVIDER CONFIGURATION
# ------------------------------------------------------------------------------
# Active AI detection provider for multimodal analysis.
# Supported choices:
#   - "demo"            : Built-in mock provider (zero API keys needed, ideal for offline/local testing)
#   - "sightengine"     : SightEngine API (Image & Video deepfake, AI-generated face/art detection)
#   - "realitydefender" : Reality Defender API (Enterprise multimodal & video deepfake detection)
#   - "resemble"        : Resemble AI Detect API (Specialized audio deepfake & speech forensics)
DETECTION_PROVIDER=demo

# --- SightEngine API (https://sightengine.com) ---
# Required if DETECTION_PROVIDER=sightengine
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# --- Resemble AI API (https://www.resemble.ai/detect/) ---
# Required if DETECTION_PROVIDER=resemble
RESEMBLE_API_KEY=

# --- Reality Defender API (https://www.realitydefender.com) ---
# Required if DETECTION_PROVIDER=realitydefender
REALITY_DEFENDER_API_KEY=

# ------------------------------------------------------------------------------
# 6. CORS & NETWORKING
# ------------------------------------------------------------------------------
# Allowed origins for FastAPI CORS middleware (JSON array format)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ------------------------------------------------------------------------------
# 7. FILE STORAGE & UPLOAD LIMITS
# ------------------------------------------------------------------------------
# Local directory path where uploaded media and forensic artifacts are stored
UPLOAD_DIR=/app/uploads
# Maximum allowed file upload size in megabytes (MB)
MAX_UPLOAD_SIZE_MB=500

# ------------------------------------------------------------------------------
# 8. FRONTEND CLIENT SETTINGS
# ------------------------------------------------------------------------------
# Base API URL used by the React client to communicate with the FastAPI backend
# - For local Vite dev server: http://localhost:8000/api/v1
# - For Docker / reverse proxy: /api/v1 or http://localhost:8000/api/v1
VITE_API_URL=http://localhost:8000/api/v1
