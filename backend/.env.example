# ==============================================================================
# Explainable Multimodal Deepfake & Media Forensics Platform
# Backend Environment Configuration (.env.example)
#
# Copy this file to backend/.env when running backend directly without Docker.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_NAME="Explainable Multimodal Deepfake & Media Forensics Platform"
APP_VERSION=0.1.0
DEBUG=true

# ------------------------------------------------------------------------------
# 2. DATABASE & CACHE
# ------------------------------------------------------------------------------
# PostgreSQL database connection (local development)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/deepfake

# Redis broker URL for Celery background tasks
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 3. JWT AUTHENTICATION
# ------------------------------------------------------------------------------
# Secret key for JWT signature (generate with: openssl rand -hex 32)
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# ------------------------------------------------------------------------------
# 4. DETECTION PROVIDERS
# ------------------------------------------------------------------------------
# Provider choice: "demo", "sightengine", "realitydefender", or "resemble"
DETECTION_PROVIDER=demo

# Resemble AI Detect API (Audio deepfakes)
RESEMBLE_API_KEY=

# Sightengine API (Image & Video deepfakes)
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# Reality Defender API (Multimodal video & image deepfakes)
REALITY_DEFENDER_API_KEY=

# ------------------------------------------------------------------------------
# 5. CORS
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ------------------------------------------------------------------------------
# 6. FILE STORAGE
# ------------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=500
